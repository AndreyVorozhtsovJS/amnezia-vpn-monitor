TELEGRAM_BOT_TOKEN=PASTE_TOKEN_FROM_BOTFATHER
# Chat used for automatic OFFLINE/ONLINE alerts.
TELEGRAM_CHAT_ID=
# Comma-separated Telegram chat IDs allowed to use commands.
# During initial setup this can be empty; set it before production use.
TELEGRAM_ALLOWED_CHAT_IDS=
CONFIG_PATH=/opt/amnezia-vpn-monitor/config.yaml
DB_PATH=/var/lib/amnezia-vpn-monitor/metrics.db
LOG_LEVEL=INFO
# External watchdog ping URL (e.g. https://hc-ping.com/<uuid>). Optional.
HEALTHCHECK_URL=
# Passphrase for nightly encrypted Amnezia backups. Store a copy in your password manager!
BACKUP_PASSPHRASE=
